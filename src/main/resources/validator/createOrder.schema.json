{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "customer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "orderDate": {
      "type": "string",
      "format": "date"
    },
    "freight": {
      "type": "number",
      "minimum": 0,
      "maximum": 99999999.99
    },
    "shipCountry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "shippingCompany": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "required": ["customer", "freight", "shipCountry", "shippingCompany"],
  "additionalProperties": false
}
